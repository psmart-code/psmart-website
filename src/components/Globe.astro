// An orthographic view of the Americas. Coordinates are longitude and latitude.
type Point = [number, number];
const continents: Point[][] = [
  [[-165,65],[-150,72],[-115,71],[-98,74],[-80,69],[-64,61],[-54,52],[-66,46],[-74,40],[-81,31],[-81,25],[-84,30],[-97,27],[-97,20],[-90,18],[-86,21],[-87,16],[-82,9],[-78,8],[-84,8],[-93,15],[-105,20],[-113,30],[-124,40],[-125,49],[-140,59],[-154,57]],
  [[-81,12],[-72,12],[-61,10],[-52,4],[-49,0],[-35,-5],[-38,-16],[-41,-22],[-48,-28],[-52,-33],[-58,-37],[-62,-40],[-65,-48],[-67,-55],[-73,-51],[-75,-43],[-71,-30],[-71,-18],[-77,-12],[-81,-5],[-79,2]],
  [[-53,60],[-44,61],[-22,72],[-18,81],[-40,84],[-61,81],[-66,76]],
  [[-17,15],[-10,30],[0,36],[12,37],[30,31],[40,15],[50,11],[42,-3],[35,-15],[28,-33],[18,-35],[12,-18],[8,-3],[1,5],[-12,6]],
  [[-10,36],[0,44],[-5,49],[6,55],[10,62],[25,72],[40,68],[45,45],[28,38],[15,40],[4,43]],
];
function inside(x:number,y:number,p:Point[]) {
  let yes=false;
  for(let i=0,j=p.length-1;i<p.length;j=i++){
    const [a,b]=p[i], [c,d]=p[j];
    if((b>y)!==(d>y) && x<(c-a)*(y-b)/(d-b)+a) yes=!yes;
  }
  return yes;
}
function project(lon:number,lat:number) {
  const r=Math.PI/180, phi=lat*r, lambda=(lon+63)*r, tilt=10*r;
  return {x:250+166*Math.cos(phi)*Math.sin(lambda), y:210-166*(Math.cos(tilt)*Math.sin(phi)-Math.sin(tilt)*Math.cos(phi)*Math.cos(lambda)), visible: Math.sin(tilt)*Math.sin(phi)+Math.cos(tilt)*Math.cos(phi)*Math.cos(lambda)>0};
}
const points=[];
for(let lat=-84;lat<85;lat+=2.2) for(let lon=-180;lon<180;lon+=2.2/Math.cos(lat*Math.PI/180)){
  const p=project(lon,lat);
  if(p.visible && continents.some(c=>inside(lon,lat,c))) points.push(p);
}
const origin=project(-66,-17);
const cities=[project(-74,41),project(-99,19),project(-3,40)];
---
<svg aria-hidden="true" viewBox="0 0 500 420" class="globe">
  <defs>
    <radialGradient id="sea" cx=".3" cy=".25" r=".85"><stop stop-color="#134b78"/><stop offset=".65" stop-color="#08274a"/><stop offset="1" stop-color="#041328"/></radialGradient>
    <pattern id="grid" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" fill="none" stroke="#18517a" stroke-opacity=".32"/></pattern>
  </defs>
  <rect width="500" height="420" fill="url(#grid)"/>
  <circle cx="250" cy="210" r="183" stroke="#225071" stroke-dasharray="2 7" fill="none"/>
  <circle cx="250" cy="210" r="166" fill="url(#sea)" stroke="#327f9d"/>
  {points.map(p=><circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="1.7" fill="#56bce6"/>)}
  {cities.map(p=><g><path d={`M${origin.x} ${origin.y} Q${(origin.x+p.x)/2-36} ${p.y-42} ${p.x} ${p.y}`} stroke="#76f0ed" fill="none"/><circle cx={p.x} cy={p.y} r="3" fill="#a8fff6"/></g>)}
  <circle cx={origin.x} cy={origin.y} r="10" fill="#43eddf" fill-opacity=".2" stroke="#72efe6"/><circle cx={origin.x} cy={origin.y} r="4" fill="white"/>
  <path d={`M${origin.x+9} ${origin.y+5} l28 26 h60`} fill="none" stroke="#85eeec"/><text x={origin.x+40} y={origin.y+26} fill="#d5ffff" font-family="monospace" font-size="11">BOLIVIA</text>
</svg>
